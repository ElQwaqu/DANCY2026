---
/** RSVP: the family contacts guests can call or message on WhatsApp. */
import ContactCard from './ContactCard.astro';
import Section from './ui/Section.astro';
import { wedding } from '../data/wedding';
import type { SectionProps } from '../lib/sections';

type Props = SectionProps;
const { tone } = Astro.props;
const { deadline, whatsappMessage, contacts } = wedding.rsvp;
---

<Section id="rsvp" tone={tone}>
  {
    deadline && (
      <p class="-mt-4 mb-10 text-center font-serif text-xl italic sm:-mt-8" data-reveal>
        Kindly let us know by <strong class="font-semibold text-gold-deep not-italic">{deadline}</strong>
      </p>
    )
  }
  <ul
    class:list={[
      'mx-auto grid max-w-md gap-6',
      contacts.length > 1 && 'sm:max-w-3xl sm:grid-cols-2',
      contacts.length > 2 && 'lg:max-w-none lg:grid-cols-3',
    ]}
  >
    {
      contacts.map((contact, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
          <ContactCard contact={contact} message={whatsappMessage} />
        </li>
      ))
    }
  </ul>
</Section>
