---
/** Interactive Google Map (embed, no API key). Lazy-loaded so it only downloads near the screen. */
import type { Venue } from '../data/types';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-champagne bg-cream">
  <iframe
    src={venue.mapEmbedUrl}
    title={`Map showing ${venue.name}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
    class="block aspect-4/3 h-auto w-full border-0"></iframe>
</div>
