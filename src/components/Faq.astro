---
/** FAQ accordion using native <details>: keyboard accessible and works without JavaScript. */
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { wedding } from '../data/wedding';
import type { SectionProps } from '../lib/sections';

type Props = SectionProps;
const { tone } = Astro.props;
---

<Section id="faq" tone={tone}>
  <div class="mx-auto max-w-2xl border-t border-champagne-light" data-reveal>
    {
      wedding.faq.map((item) => (
        <details class="group border-b border-champagne-light">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-left font-serif text-xl sm:text-2xl [&::-webkit-details-marker]:hidden">
            {item.question}
            <Icon
              name="plus"
              class="h-5 w-5 text-gold-deep transition-transform duration-300 group-open:rotate-45 motion-reduce:transition-none"
            />
          </summary>
          <p class="pb-6 text-charcoal-soft">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
