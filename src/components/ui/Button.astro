---
/** Large, thumb-friendly link or button (at least 48px tall). */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  variant?: 'gold' | 'sage' | 'outline';
  icon?: IconName;
  href?: string;
  /** Tighter padding for side-by-side buttons on narrow phones. */
  compact?: boolean;
};

const { variant = 'gold', icon, href, compact = false, class: className, ...rest } = Astro.props;

const styles = {
  gold: 'bg-gold-deep text-ivory hover:bg-charcoal',
  sage: 'bg-sage-deep text-ivory hover:bg-charcoal',
  outline: 'border border-gold-deep text-gold-deep hover:bg-gold-deep hover:text-ivory',
}[variant];

const classes = [
  'inline-flex min-h-12 items-center justify-center gap-2 rounded-full py-3 text-sm font-bold uppercase transition-colors duration-200 motion-reduce:transition-none',
  compact ? 'px-3 tracking-[0.06em]' : 'px-6 tracking-[0.12em]',
  styles,
  className,
];
const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={href ? undefined : 'button'} class:list={classes} {...rest}>
  {icon && <Icon name={icon} />}
  <slot />
</Tag>
