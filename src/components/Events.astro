---
/**
 * Events: one card per ceremony in wedding.ts, in the order listed there.
 * When every event is at the same venue, the venue and map are shown once
 * above the cards, so guests download one map instead of several.
 */
import Button from './ui/Button.astro';
import EventCard from './EventCard.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import VenueMap from './VenueMap.astro';
import { wedding } from '../data/wedding';
import { directionsHref, sharedVenue } from '../lib/events';
import type { SectionProps } from '../lib/sections';

type Props = SectionProps;
const { tone } = Astro.props;
const count = wedding.events.length;
const venue = sharedVenue(wedding.events);
---

<Section id="events" tone={tone}>
  {
    venue && (
      <div
        class="mx-auto mb-10 max-w-xl border border-champagne-light bg-ivory p-6 text-center outline outline-champagne-light/70 -outline-offset-8 sm:p-8 lg:mb-12 lg:grid lg:max-w-5xl lg:grid-cols-2 lg:items-center lg:gap-10 lg:text-left"
        data-reveal
      >
        <div>
          <p class="eyebrow">Venue</p>
          <h3 class="mt-3 flex items-start justify-center gap-2 text-3xl lg:justify-start">
            <Icon name="pin" class="mt-1.5 hidden h-6 w-6 text-gold-deep lg:block" />
            <span>{venue.name}</span>
          </h3>
          {venue.address && <address class="mt-2 text-charcoal-soft not-italic">{venue.address}</address>}
          <p class="mt-3 text-charcoal-soft">All celebrations take place here.</p>
          <Button href={directionsHref(venue)} icon="directions" class="mt-6 w-full sm:w-auto" target="_blank" rel="noopener noreferrer">
            Get directions<span class="sr-only"> to {venue.name} (opens Google Maps)</span>
          </Button>
        </div>
        <div class="mt-6 lg:mt-0">
          <VenueMap venue={venue} />
        </div>
      </div>
    )
  }

  <ul
    class:list={[
      'mx-auto grid gap-8',
      count >= 3 ? 'max-w-xl lg:max-w-none lg:grid-cols-3' : count === 2 ? 'max-w-xl md:max-w-4xl md:grid-cols-2' : 'max-w-xl',
    ]}
  >
    {
      wedding.events.map((event, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
          <EventCard event={event} showVenue={!venue} />
        </li>
      ))
    }
  </ul>
</Section>
